{
  "name": "travel-ai-automation-platform",
  "version": "0.1.1",
  "description": "A TypeScript and PostgreSQL reference implementation for converting Kakao travel inquiries into CRM customer records and booking leads.",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://cstion-ai.github.io/cstion/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cstion-ai/cstion.git"
  },
  "bugs": {
    "url": "https://github.com/cstion-ai/cstion/issues"
  },
  "keywords": [
    "typescript",
    "travel",
    "kakao",
    "crm",
    "booking",
    "webhook",
    "idempotency",
    "postgresql"
  ],
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit && tsc --project tsconfig.test.json",
    "build": "tsc && node scripts/copy-build-assets.mjs",
    "check:all": "npm run test:coverage && npm run evaluate:parser && npm run typecheck && npm run build && cmp src/repositories/migrations/001_harden_existing_schema.sql dist/src/repositories/migrations/001_harden_existing_schema.sql && npm audit --audit-level=high",
    "db:migrate": "tsx src/repositories/migrate.ts",
    "db:migrate:prod": "node dist/src/repositories/migrate.js",
    "demo": "tsx src/pipelines/kakao-to-crm.ts",
    "dev": "tsx src/pipelines/kakao-to-crm.ts",
    "evaluate:parser": "tsx src/evaluation/run-reservation-evaluation.ts",
    "evaluate:parser:prod": "node dist/src/evaluation/run-reservation-evaluation.js",
    "start": "node dist/src/server.js",
    "dev:server": "tsx src/server.ts",
    "test": "tsx --test test/*.test.ts",
    "test:coverage": "c8 tsx --test test/*.test.ts",
    "test:postgres": "tsx --test test/postgres-live.integration.ts"
  },
  "c8": {
    "all": true,
    "src": [
      "src"
    ],
    "extension": [
      ".ts"
    ],
    "include": [
      "src/**/*.ts"
    ],
    "exclude": [
      "src/adapters/interfaces.ts"
    ],
    "exclude-after-remap": true,
    "reporter": [
      "text"
    ],
    "check-coverage": true,
    "lines": 90,
    "branches": 80,
    "functions": 85
  },
  "dependencies": {
    "pg": "^8.22.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/pg": "^8.20.0",
    "c8": "^11.0.0",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  }
}
